# --- 签名密钥与凭据：绝不允许进入版本库 ---
# .jks 是 application 所有权的证明，泄露等于别人可以冒充你发布更新。
# keystore.properties 里是明文口令。
*.jks
keystore.properties

# 本地生成、不参与构建的目录
/_deprecated

# --- 公开仓库合规排除（详见 THIRD-PARTY-NOTICES.md）---
# doc_segmentation.tflite 为 GPL-3.0 模型（训练数据 CC BY-NC-SA），
# 进公开仓库即构成对外分发，违反许可。自用版构建请按 NOTICES 说明自行放置。
app/src/main/assets/doc_segmentation.tflite

# GPL 模型下载物与内部调试目录
/_model_dl
/_bug151

# 训练数据与产物：体积过大（GB 级），且 synth* 由受许可约束的数据生成
/tools/train/data/
/tools/train/out_hand/best.keras
/tools/train/evalout_hand/

# 本地产物目录（APK 已被上面 *.apk 覆盖，这里兜底其余文件）
/outputs/

# 工作区运行时文件
*.log
nohup.out

# doc_seg (GPL/fairscan-gpl) training artifacts - never publish
tools/train/out_v*/
tools/train/evalout_v*/

# jvmcheck 桌面测试的构建缓存，不进版本库
tools/jvmcheck/build/

# --- 内部调试图片与算法对比图（2026-10-24 合规整改）---
# tools/ 下累计 190+ 张对比图/热力图，其中 book2.jpg、photo_full.jpg、
# text_photo_full.jpg 等是真实出版物书页照片——受版权保护的出版物内容，
# 放在公开仓库等于无限复制分发。文件保留在磁盘供本地复现，但不入版本库。
tools/**/*.jpg
tools/**/*.jpeg
tools/**/*.png
tools/**/*.gif
tools/**/*.bmp
tools/**/*.mp4

# --- 本地探测用的第三方二进制与编译产物 ---
# libtensorflowlite_jni.so / tflite.jar 等是从 TFLite AAR 拆出的探测用文件，
# *.class 是 javac 产物；均属开发期本地文件，不对外分发。
tools/**/*.so
tools/**/*.jar
tools/**/*.class
tools/**/dl/

# --- 内部部署工具的日志与本地缓存 ---
# deploy_fn.log 等可能含环境标识；.wrangler/ 内含 Cloudflare 账号信息。
tools/**/*.log
tools/counter/.wrangler/
